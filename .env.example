# Сети через запятую: bsc, base, robinhood
NETWORKS=bsc,base,robinhood
DB_PATH=candidates.db
COOLDOWN_HOURS=24

# Codex (screener, этап 2)
CODEX_API_KEY=
SCREEN_LIMIT=50
# volumeUSD24 | volumeUSD1 | volumeUSD4 | volumeUSD12 | liquidity | trendingScore1 | trendingScore24 | poolFeeBps
SCREEN_RANK_BY=volumeUSD24
SCREEN_MIN_VOLUME_24H=0

# Telegram (этап 4)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Ollama на ПК в локальной сети (этап 5)
OLLAMA_URL=http://192.168.1.10:11434
OLLAMA_MODEL=

# Пороги скоринга (необязательно, по умолчанию см. token_monitor/scoring.py:Params)
